[Unit]
Description=CatRecap pet activity clipper
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/catRecap
ExecStart=/home/pi/.local/bin/uv run --locked catrecap run
Restart=always
RestartSec=10
# 摄像头断线、Telegram 超时都在进程内自愈，这里兜底进程级崩溃。

[Install]
WantedBy=multi-user.target
