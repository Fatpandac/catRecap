# 复制为 .env 后填写；请勿提交真实摄像头地址、账号密码或 Telegram token。
CAMERA_URL=rtsp://username:password@camera-host:554/stream
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 检测：默认用 COCO 预训练模型的 cat / dog 类别。
# 树莓派上建议换成 NCNN 导出目录（见 README），推理快好几倍。
YOLO_MODEL=yolo11n.pt
PET_CLASSES=cat,dog
DETECTION_CONFIDENCE=0.5
DETECTION_INTERVAL=0.4
DETECTION_IMGSZ=320

# 活动判定与片段参数，时间单位为秒。
# MOVE_THRESHOLD 是归一化画面坐标下的质心位移，调大更迟钝、调小更灵敏。
MOVE_THRESHOLD=0.02
CLIP_PRE_SECONDS=3
CLIP_POST_SECONDS=5
CLIP_MAX_SECONDS=30
NOTIFICATION_COOLDOWN_SECONDS=60
OUTPUT_DIR=data/clips
