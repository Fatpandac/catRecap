# 后续流水线实现的配置约定；当前 CLI 尚不读取 .env。
# 请勿提交真实摄像头地址、账号密码或 Telegram token。
CAMERA_URL=rtsp://username:password@camera-host:554/stream
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 初始采用 COCO 预训练模型的 cat / dog 类别；不等同于行为分类。
YOLO_MODEL=yolo11n.pt
PET_CLASSES=cat,dog
DETECTION_CONFIDENCE=0.5

# 片段缓冲与推送参数，单位为秒；具体活动判定阈值待视频样本验证。
CLIP_PRE_SECONDS=3
CLIP_POST_SECONDS=5
CLIP_MAX_SECONDS=30
NOTIFICATION_COOLDOWN_SECONDS=60
OUTPUT_DIR=data/clips
