# 复制为 .env 后填写；请勿提交真实摄像头地址、账号密码或 Telegram token。

# 检测流：推荐 720p；前景分析缩到宽 640，再从原图裁局部窗口供 YOLO 识别。
# 360p 原图在当前机位的正样本上漏检，不能靠放大恢复细节。
CAMERA_URL=rtsp://username:password@camera-host:554/ch2
# 录制流：高清通道，ffmpeg 以 -c copy 持续分段落盘，片段从这里剪。留空则直接录检测流。
RECORD_URL=rtsp://username:password@camera-host:554/ch1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 默认 pet_motion：必须确认宠物类别，并且运动发生在宠物框内；识别不到就不发。
# motion 是通用运动模式，会把人物/影子等活动发出，不适合只关注宠物。
# yolo 保留原来的宠物检测 + 质心位移判定。
TRIGGER_MODE=pet_motion
MOTION_MIN_RATIO=0.0008
MOTION_MAX_RATIO=0.5
MOTION_WARMUP_FRAMES=15
# 下列三项只用于通用 motion 模式。pet_motion 不用人体框抹掉已确认的猫。
MOTION_IGNORE_PEOPLE=true
MOTION_PERSON_CONFIDENCE=0.4
# 按人体框最长边向四周扩展，抑制肢体/椅子/影子；框太大可调小。
MOTION_PERSON_MARGIN=0.5
# 灰度差阈值 + 连续采样确认，过滤静止前景、噪声与单次闪动。
MOTION_PIXEL_THRESHOLD=15
MOTION_CONFIRM_FRAMES=2

# 各模式共用的采样间隔（秒）。15 帧预热在默认间隔下约需 6 秒。
DETECTION_INTERVAL=0.4

# pet_motion / yolo 均按 PET_CLASSES 和 DETECTION_CONFIDENCE 确认宠物。
# YOLO_MODEL / DETECTION_IMGSZ 同时用于宠物识别与人体过滤。
# 模型可以换成 NCNN 导出目录（见 README），性能需在树莓派上实测。
YOLO_MODEL=yolo11n.pt
PET_CLASSES=cat
DETECTION_CONFIDENCE=0.5
DETECTION_IMGSZ=320

# 活动判定与片段参数，时间单位为秒。
# MOVE_THRESHOLD 仅供 yolo 模式使用；motion 灵敏度调整 MOTION_MIN_RATIO。
MOVE_THRESHOLD=0.02
CLIP_PRE_SECONDS=3
CLIP_POST_SECONDS=5
CLIP_MAX_SECONDS=30
NOTIFICATION_COOLDOWN_SECONDS=60
OUTPUT_DIR=data/clips

# 滚动录像：三道防线同时生效，任一触发都从最旧的分段开始删，防止写满磁盘。
# 1080p 约 1.1Mbps ≈ 500MB/小时，按这个估算保留时长。
SEGMENT_DIR=data/segments
SEGMENT_SECONDS=30
SEGMENT_KEEP_MINUTES=10
SEGMENT_MAX_MB=2048
DISK_MIN_FREE_MB=1024
